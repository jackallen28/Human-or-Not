# Copy to .env when running on your own computer. On Render, set these under
# your service → Environment instead (the blueprint asks for the first two).

# Your Claude API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# The code you type to open the teacher console. Pick something students won't guess.
TEACHER_CODE=

# Optional: a Postgres connection string. Without it, data is stored in ./data.
# DATABASE_URL=

# Optional: pin a specific model instead of the newest in each family.
# MODEL_HAIKU=claude-haiku-4-5
# MODEL_SONNET=claude-sonnet-5-5
# MODEL_OPUS=claude-opus-5-5

# Optional: the address printed on the login cards, if the automatic one is wrong.
# PUBLIC_URL=https://human-or-not.onrender.com
