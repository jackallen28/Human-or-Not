# Copy to .env when running on your own computer. On Render, set these under
# your service → Environment instead (the blueprint asks for the first four).

# Your Claude API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# One password per teacher. Each teacher has their own console (/teacher/1,
# /teacher/2, /teacher/3) with their own classes and activities. Leave one
# blank to switch that console off. Pick passwords students won't guess.
TEACHER_1_CODE=
TEACHER_2_CODE=
TEACHER_3_CODE=

# Optional: names shown on the consoles instead of "Teacher 1" etc.
# TEACHER_1_NAME=Ms Allen
# TEACHER_2_NAME=
# TEACHER_3_NAME=

# Optional: a Postgres connection string. Without it, data is stored in ./data.
# DATABASE_URL=

# Optional: the model that trains briefs, analyses rounds and writes overviews
# (default Sonnet at medium effort, to save cost).
# ANALYST_MODEL=sonnet
# ANALYST_EFFORT=medium

# Optional: pin a specific model instead of the newest in each family.
# MODEL_HAIKU=claude-haiku-4-5
# MODEL_SONNET=claude-sonnet-5-5
# MODEL_OPUS=claude-opus-5-5

# Optional: the time zone for download names (default Australia/Melbourne).
# TIME_ZONE=Australia/Melbourne

# The address printed on the login cards (otherwise the address you open the console at).
# PUBLIC_URL=https://human-or-not.allentronics.com.au
